# Copiar a backend/.env y completar SOLO localmente. Nunca versionar .env.
BLUEFLORA_ENVIRONMENT=development
BLUEFLORA_APP_NAME=BlueFlora API
BLUEFLORA_DOCS_ENABLED=true
# Descomentar con contraseñas reales codificadas como componente de URL.
# BLUEFLORA_DATABASE_URL=postgresql+psycopg://blueflora_dev:REEMPLAZAR@127.0.0.1:5432/blueflora_dev
# BLUEFLORA_TEST_DATABASE_URL=postgresql+psycopg://blueflora_test:REEMPLAZAR@127.0.0.1:5432/blueflora_test
# Ejecución API: roles distintos de migraciones, sin propiedad ni DDL.
# Su presencia habilita los endpoints de autenticación; nunca hay fallback a migraciones.
# BLUEFLORA_API_DATABASE_URL=postgresql+psycopg://blueflora_api:REEMPLAZAR@127.0.0.1:5432/blueflora_dev
# BLUEFLORA_TEST_API_DATABASE_URL=postgresql+psycopg://blueflora_api_test:REEMPLAZAR@127.0.0.1:5432/blueflora_test
